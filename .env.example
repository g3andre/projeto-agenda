# Copie para .env e ajuste os valores:
#   cp .env.example .env

# URI do MongoDB (Mongoose + sessões em connect-mongo).
# O nome do banco no path final (ex.: /agenda) pode ser o que você preferir.

# MongoDB na sua máquina (sem Docker):
CONNECTIONSTRING=mongodb://127.0.0.1:27017/agenda

# Com docker compose deste projeto, use o hostname do serviço "mongo":
# CONNECTIONSTRING=mongodb://mongo:27017/agenda

# MongoDB com usuário e senha (exemplo):
# CONNECTIONSTRING=mongodb://usuario:senha@127.0.0.1:27017/agenda?authSource=admin
